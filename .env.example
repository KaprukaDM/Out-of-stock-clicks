# Query cache (see README > Performance notes > Caching). Correctness does
# not depend on these: the cache is cleared on every GA4 refresh. Lower
# CACHE_MAX_ROWS if the VPS is tight on memory — ~80k rows is roughly 55 MB.
# CACHE_MAX_ROWS=80000
# CACHE_MAX_ENTRIES=24
# CACHE_TTL_SECONDS=900

